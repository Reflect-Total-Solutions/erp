  userId            String           @map("user_id")
  category          String           @default("SUPPLIER_PAYMENT")
  type              String           // "UPCOMING_DUE_REMINDER" | "DUE_TODAY" | "OVERDUE" | "PARTIAL_PAYMENT_RECORDED" | "FULL_PAYMENT_COMPLETED"
  title             String
  message           String
  linkUrl           String?          @map("link_url")
  supplierInvoiceId String?          @map("supplier_invoice_id")
