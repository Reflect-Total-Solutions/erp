  action       String               // "CREATE" | "EDIT" | "CANCEL"
  reason       String?
  previousData Json?                @map("previous_data")
  newData      Json?                @map("new_data")
  createdAt    DateTime             @default(now()) @map("created_at")

  expense      JobAdditionalExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user         User?                @relation("JobAdditionalExpenseAuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([expenseId, createdAt])
  @@index([jobId, createdAt])
  @@map("job_additional_expense_audit_logs")
}

